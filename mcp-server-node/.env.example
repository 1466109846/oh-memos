# ============================================================================
# oh-memos-mcp Environment Configuration
# ============================================================================
# Copy this file to .env in your project root and adjust values.
# Priority: CLI flags > explicit env file > inherited environment > discovered .env > defaults
# A discovered .env only fills gaps; it never overrides MCP client env values.
# Set MEMOS_ENV_FILE when a specific file must be authoritative (recommended for npx).
# ============================================================================

# --- Required (Full/API mode) ---
MEMOS_URL=http://localhost:18000        # oh-memos API address (may be empty in local mode)
MEMOS_USER=dev_user                     # Default user ID
MEMOS_DEFAULT_CUBE=dev_cube             # Default memory cube ID
MEMOS_CUBES_DIR=/path/to/cubes          # Absolute path to cubes directory

# --- Provider selection ---
# MEMOS_PROVIDER=api                    # api = Full backend via Python API (default)
# MEMOS_PROVIDER=local                  # local = Lite JSONL store, no Python API needed
# MEMOS_MODE=lite                       # Shorthand: implies MEMOS_PROVIDER=local

# --- Lite local embeddings (optional, only for MEMOS_PROVIDER=local) ---
# Semantic ranking for the Lite store talks to an Ollama-compatible endpoint.
# It expects the Ollama /api/embeddings protocol, so point it at an Ollama
# host (local or self-hosted remote) — cloud OpenAI-compatible embedding
# endpoints belong to the Full backend instead (see docker/.env.docker.example,
# MOS_EMBEDDER_*). Defaults below need no configuration at all.
# MEMOS_LITE_EMBED_URL=http://127.0.0.1:11434   # Ollama endpoint
# MEMOS_LITE_EMBED_MODEL=bge-m3                  # any embedding model you pulled
# MEMOS_LITE_EMBED=off                           # pin lexical-only ranking explicitly

# --- Timeouts (seconds) ---
# MEMOS_TIMEOUT_TOOL=300                # Tool call timeout (default: 300)
# MEMOS_TIMEOUT_STARTUP=30              # Startup timeout (default: 30)
# MEMOS_TIMEOUT_HEALTH=5                # Health check timeout (default: 5)
# MEMOS_API_WAIT_MAX=60                 # Max API wait time (default: 60)

# --- Feature Flags ---
# MEMOS_ENABLE_DELETE=false             # Enable memory deletion (default: false)
# MEMOS_LOG_LEVEL=WARNING               # DEBUG | INFO | WARNING | ERROR

# --- Neo4j (optional, for direct graph queries) ---
# NEO4J_HTTP_URL=http://localhost:7474
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password
